# GENERATED by utils/fetch-maps — don't edit; re-run the script to refresh the maps.
# Not fetched by URL: Protomaps deletes its daily builds within a week (devguide "Maps").
{ pkgs }:
let
  pinned =
    name: hash:
    pkgs.requireFile {
      name = "${name}.pmtiles";
      inherit hash;
      message = ''
        The built-in map ${name}.pmtiles is not in the Nix store on this machine.
        Run utils/fetch-maps from the repository root (needs internet, ~400 MB);
        see the developer guide, page "Maps".
      '';
    };
in
{
  date = "20261027"; # Protomaps build the maps were cut from
  maps = {
    world = pinned "world" "sha256-+fZS7Es3nunJQsjJhMv24kkUam2vug+UoIEV6cBskq8=";
    central-europe = pinned "central-europe" "sha256-0mWP+nMWhSOLKLEU6eMmajAtvcUdExmLACStnu2mLYo=";
    czechia = pinned "czechia" "sha256-nX/Uvc0LdqkB86j/A6O5kSFfq7JSvHqVALtOsWL99Fc=";
  };
}
